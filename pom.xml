<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM PADRE (agregador). No genera ningún .jar: solo agrupa los 3 módulos
    y define en un solo lugar la versión de Java, las versiones de las
    dependencias y de los plugins.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.eq2</groupId>
    <artifactId>parchis</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Parchis - Equipo 2</name>

    <modules>
        <module>parchis-comunes</module>
        <module>parchis-servidor</module>
        <module>parchis-cliente</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Carpeta donde quedan los dos ejecutables, uno junto al otro -->
        <parchis.dist>${maven.multiModuleProjectDirectory}/dist</parchis.dist>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.eq2</groupId>
                <artifactId>parchis-comunes</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.4</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- JUnit disponible en los 3 módulos para pruebas -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <!--
                    Shade empaqueta el módulo + parchis-comunes en un solo .jar ejecutable.
                    Cada módulo ejecutable solo indica su clase main y el nombre del .jar.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals><goal>shade</goal></goals>
                            <configuration>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                                <outputFile>${parchis.dist}/${parchis.ejecutable}.jar</outputFile>
                                <transformers>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                        <mainClass>${exec.mainClass}</mainClass>
                                    </transformer>
                                </transformers>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
